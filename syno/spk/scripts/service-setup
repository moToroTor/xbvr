#!/bin/sh
# XBVR service definition (follows spksrc generic service conventions).
# The binary reads var/.env via godotenv, so the wizard-written .env sets
# XBVR_APPDIR, XBVR_WEB_PORT and DATABASE_URL for every start.

XBVR_BIN="${SYNOPKG_PKGDEST}/bin/xbvr"
SERVICE_COMMAND="${XBVR_BIN}"
SVC_BACKGROUND=y
SVC_WRITE_PID=y
PID_FILE="${SYNOPKG_PKGVAR}/xbvr.pid"
LOG_FILE="${SYNOPKG_PKGVAR}/xbvr.log"

# Run with the var dir as cwd: .env, main.db (sqlite fallback), bin/ and
# volumes.txt live there.
SVC_CWD="${SYNOPKG_PKGVAR}"

dotenv_quote()
{
    # Quote $1 for the .env file: single quotes, newlines stripped
    # (wizard fields are single-line), embedded quotes escaped.
    # Empty is special-cased: BSD/busybox sed emit no output for
    # empty input (no lines to process), which would leave the value
    # bare and sed-dependent.
    if [ -z "$1" ]; then
        printf "''"
        return 0
    fi
    printf '%s' "$1" | tr -d '\r\n' | sed -e "s/'/'\\\\''/g" -e "s/^/'/" -e "s/$/'/"
}

db_use()
{
    # True only on an explicit opt-in. Unset (wizard-less seed, legacy
    # installs) means sqlite: the safe default that needs no server.
    # The fresh-install wizard defaults the checkbox to on.
    case "${wizard_db_use:-false}" in
        true|1|yes) return 0 ;;
        *) return 1 ;;
    esac
}

write_dotenv()
{
    # Write ${SYNOPKG_PKGVAR}/.env from wizard_* answers.
    # Ensure the var dir exists first; a missing dir must fail loudly.
    # The MariaDB root password is used once by ensure_db and never stored.
    mkdir -p "${SYNOPKG_PKGVAR}" || return 1
    {
        echo "# Generated by the XBVR package installer."
        echo "# Edit with care: database values are secrets."
        printf 'XBVR_APPDIR=%s\n' "$(dotenv_quote "${SYNOPKG_PKGVAR}")"
        printf 'XBVR_WEB_PORT=%s\n' "$(dotenv_quote "${wizard_port:-9999}")"
        printf 'DATABASE_URL=%s\n' "$(dotenv_quote "$(build_database_url)")"
    } > "${SYNOPKG_PKGVAR}/.env"
    chmod 600 "${SYNOPKG_PKGVAR}/.env"
}

build_database_url()
{
    # MariaDB on DSM listens on 3307 by default. Anything but an explicit
    # MariaDB opt-in keeps the sqlite fallback (empty DATABASE_URL).
    if ! db_use; then
        return 0
    fi
    dbhost="${wizard_db_host:-127.0.0.1}"
    dbport="${wizard_db_port:-3307}"
    dbname="${wizard_db_name:-xbvr}"
    dbuser="${wizard_db_user:-xbvr}"
    dbpass="${wizard_db_pass:-}"
    if [ -n "$dbuser" ]; then
        printf 'mysql://%s:%s@%s:%s/%s' "$dbuser" "$dbpass" "$dbhost" "$dbport" "$dbname"
    else
        printf 'mysql://%s:%s/%s' "$dbhost" "$dbport" "$dbname"
    fi
}

sql_escape()
{
    # Double single quotes for SQL string literals. Identifiers are
    # backtick-quoted by the caller; backticks in names are rejected.
    printf '%s' "$1" | sed -e "s/'/''/g"
}

mysql_client()
{
    # MYSQL_CLIENT overrides the search (tests). Otherwise the MariaDB10
    # package path wins over PATH.
    if [ -n "${MYSQL_CLIENT:-}" ]; then
        printf '%s' "$MYSQL_CLIENT"
        return 0
    fi
    for c in /usr/local/mariadb10/bin/mysql /usr/bin/mysql; do
        if [ -x "$c" ]; then
            printf '%s' "$c"
            return 0
        fi
    done
    command -v mysql 2>/dev/null
}

ensure_db()
{
    # Idempotently create the database and user. No-op for sqlite.
    if ! db_use; then
        return 0
    fi
    dbhost="${wizard_db_host:-127.0.0.1}"
    dbport="${wizard_db_port:-3307}"
    dbname="${wizard_db_name:-xbvr}"
    dbuser="${wizard_db_user:-xbvr}"
    dbpass="${wizard_db_pass:-}"
    case "$dbname$dbuser" in
        *'`'*) echo "database/user names must not contain backticks" >&2; return 1 ;;
    esac
    client=$(mysql_client)
    if [ -z "$client" ]; then
        echo "MariaDB selected but no mysql client found: install the MariaDB10 package first" >&2
        return 1
    fi
    auth=""
    if [ -n "${wizard_db_root_pass:-}" ]; then
        auth="-p${wizard_db_root_pass}"
    fi
    # shellcheck disable=SC2086
    if ! "$client" -h"$dbhost" -P"$dbport" -uroot $auth -e "SELECT 1" >/dev/null 2>&1; then
        echo "cannot reach MariaDB at $dbhost:$dbport as root (wrong root password, or MariaDB10 not running?)" >&2
        return 1
    fi
    sql="CREATE DATABASE IF NOT EXISTS \`$dbname\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
    sql="$sql CREATE USER IF NOT EXISTS '$(sql_escape "$dbuser")'@'%' IDENTIFIED BY '$(sql_escape "$dbpass")';"
    sql="$sql CREATE USER IF NOT EXISTS '$(sql_escape "$dbuser")'@'localhost' IDENTIFIED BY '$(sql_escape "$dbpass")';"
    sql="$sql GRANT ALL PRIVILEGES ON \`$dbname\`.* TO '$(sql_escape "$dbuser")'@'%';"
    sql="$sql GRANT ALL PRIVILEGES ON \`$dbname\`.* TO '$(sql_escape "$dbuser")'@'localhost';"
    sql="$sql FLUSH PRIVILEGES;"
    # shellcheck disable=SC2086
    if ! printf '%s' "$sql" | "$client" -h"$dbhost" -P"$dbport" -uroot $auth >/dev/null 2>&1; then
        echo "failed to create database/user in MariaDB (see log)" >&2
        return 1
    fi
}

link_ffbins()
{
    # XBVR self-downloads ffprobe+ffmpeg 4.2.1 into AppDir/bin on first
    # run and skips the download when the files exist. Prefer the system
    # ffmpeg6 package (newer demuxers, fewer probe errors): symlink it in
    # when present, never overwrite existing files.
    mkdir -p "${SYNOPKG_PKGVAR}/bin" || return 1
    for tool in ffprobe ffmpeg; do
        dest="${SYNOPKG_PKGVAR}/bin/${tool}"
        if [ -e "$dest" ]; then
            continue
        fi
        sysbin=$(command -v "$tool" 2>/dev/null)
        if [ -n "$sysbin" ]; then
            ln -s "$sysbin" "$dest"
        fi
    done
}

resolve_share()
{
    # $1 = share name. Prints /volume*/<share> for the first volume that
    # has it. Shares live at the volume root on DSM. SYNOPKG_VOLUME_GLOB
    # overrides the search roots (tests; unquoted expansion is intended).
    # shellcheck disable=SC2086
    for v in ${SYNOPKG_VOLUME_GLOB:-/volume*}; do
        if [ -d "$v/$1" ]; then
            printf '%s' "$v/$1"
            return 0
        fi
    done
    return 1
}

write_volumes_reminder()
{
    # Volumes themselves are DB rows added in the XBVR UI
    # (Settings -> Storage); the wizard can only collect the paths.
    # Persist them as a reminder the user works through once.
    # Share ACLs cannot be granted from a wizard (DSM needs the manual
    # File Station step documented on the wizard's Permissions page).
    if [ -f "${SYNOPKG_PKGVAR}/volumes.txt" ]; then
        return 0
    fi
    subdirs="${wizard_video_subdirs:-}"
    if [ -n "${wizard_video_share:-}" ]; then
        base=$(resolve_share "${wizard_video_share}") || {
            echo "share '${wizard_video_share}' not found under /volume*" >&2
            return 1
        }
        if [ -z "$subdirs" ]; then
            subdirs="$base"
        else
            # Trailing newline: without it read(1) exits false on the
            # last fragment and while drops the final directory.
            subdirs=$(printf '%s\n' "$subdirs" | tr ',' '\n' | while IFS= read -r d; do
                d=$(printf '%s' "$d" | sed -e 's/^ *//' -e 's/ *$//')
                if [ -z "$d" ]; then
                    continue
                fi
                # Absolute if stripping a leading / changes it (no case
                # here: some shells misparse case inside $( )).
                if [ "$d" != "${d#/}" ]; then
                    printf '%s\n' "$d"
                else
                    printf '%s\n' "$base/$d"
                fi
            done | paste -sd ',' -)
        fi
    elif [ -z "$subdirs" ]; then
        return 0
    fi
    {
        echo "# Add each path below as a local Volume in the XBVR UI"
        echo "# (Settings -> Storage), then delete this reminder."
        printf '%s\n' "$subdirs" | tr ',' '\n' | while IFS= read -r d; do
            d=$(printf '%s' "$d" | sed -e 's/^ *//' -e 's/ *$//')
            [ -n "$d" ] && echo "$d"
        done
    } > "${SYNOPKG_PKGVAR}/volumes.txt"
}

service_postinst()
{
    # Fresh install only: never overwrite an existing .env.
    if [ -f "${SYNOPKG_PKGVAR}/.env" ]; then
        link_ffbins
        return 0
    fi
    if db_use; then
        ensure_db || return 1
    fi
    write_dotenv || return 1
    link_ffbins
    write_volumes_reminder
}

service_postupgrade()
{
    # The upgrade wizard pre-fills every box, so submitting rewrites the
    # shown values. A wizard-less upgrade keeps the file, but never leaves
    # the package without one.
    if [ ! -f "${SYNOPKG_PKGVAR}/.env" ]; then
        if db_use; then
            ensure_db || return 1
        fi
        write_dotenv || return 1
        link_ffbins
        write_volumes_reminder
        return 0
    fi
    if [ -z "${wizard_port:-}" ] && [ -z "${wizard_db_use:-}" ] && [ -z "${wizard_video_share:-}" ] && [ -z "${wizard_video_subdirs:-}" ]; then
        link_ffbins
        return 0
    fi
    if db_use; then
        ensure_db || return 1
    fi
    write_dotenv || return 1
    link_ffbins
    write_volumes_reminder
}

service_prestart()
{
    # Ensure dirs exist and export the .env for the daemon: start-stop
    # runs the binary in this shell, so exports persist.
    mkdir -p "${SYNOPKG_PKGVAR}" "${SYNOPKG_PKGVAR}/bin"
    if [ -f "${SYNOPKG_PKGVAR}/.env" ]; then
        set -a
        . "${SYNOPKG_PKGVAR}/.env"
        set +a
    fi
}
