#!/bin/sh
# XBVR start-stop-status (adapted from spksrc's generic template).

DNAME="XBVR"

SVC_SETUP=$(dirname "$0")"/service-setup"
if [ -r "${SVC_SETUP}" ]; then
    . "${SVC_SETUP}"
fi

call_func()
{
    FUNC="$1"
    if type "${FUNC}" 2>/dev/null | grep -q 'function' 2>/dev/null; then
        echo "Begin ${FUNC}" >> "${LOG_FILE}"
        eval "${FUNC}" >> "${LOG_FILE}"
        echo "End ${FUNC}" >> "${LOG_FILE}"
    fi
}

daemon_status()
{
    status=0
    pid_list=$(cat "${PID_FILE}" 2>/dev/null)
    if [ -n "${pid_list}" ]; then
        for pid in ${pid_list}; do
            kill -0 "${pid}" > /dev/null 2>&1
            status=$((status + $?))
        done
        if [ "${status}" -ne 0 ]; then
            rm -f "${PID_FILE}" > /dev/null
            return 1
        else
            return 0
        fi
    else
        return 1
    fi
}

wait_for_status()
{
    counter=${2}
    counter="${counter:=20}"
    while [ "${counter}" -gt 0 ]; do
        daemon_status "${3}"
        [ "$?" -eq "$1" ] && return
        counter=$((counter - 1))
        sleep 1
    done
    return 1
}

start_daemon()
{
    date > "${LOG_FILE}"
    call_func "service_prestart"
    if [ -n "${SVC_CWD}" ]; then
        cd "${SVC_CWD}" || { echo "Failed to cd to ${SVC_CWD}" >> "${LOG_FILE}"; exit 1; }
    fi
    echo "Starting ${DNAME} ..." >> "${LOG_FILE}"
    ${SERVICE_COMMAND} >> "${LOG_FILE}" 2>&1 &
    if [ -n "${SVC_WRITE_PID}" ] && [ -n "${PID_FILE}" ]; then
        printf "%s" "$!" > "${PID_FILE}"
    else
        wait_for_status 0 20
    fi
}

stop_daemon()
{
    if [ -n "${PID_FILE}" ] && [ -r "${PID_FILE}" ]; then
        for pid in $(cat "${PID_FILE}"); do
            echo "Stopping ${DNAME} (${pid})" >> "${LOG_FILE}"
            kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
            wait_for_status 1 20 "${pid}" || kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
        done
        rm -f "${PID_FILE}" > /dev/null
    fi
    call_func "service_poststop"
}

case $1 in
    start)
        if daemon_status; then
            echo "${DNAME} is already running"
            exit 0
        else
            start_daemon
            exit $?
        fi
        ;;
    stop)
        if daemon_status; then
            stop_daemon
            exit $?
        else
            echo "${DNAME} is not running"
            exit 0
        fi
        ;;
    status)
        if daemon_status; then
            echo "${DNAME} is running"
            exit 0
        else
            echo "${DNAME} is not running"
            exit 3
        fi
        ;;
    log)
        if [ -n "${LOG_FILE}" ] && [ -r "${LOG_FILE}" ]; then
            TEMP_LOG_FILE="${SYNOPKG_PKGVAR}/${SYNOPKG_PKGNAME}_temp.log"
            echo "Full log: ${LOG_FILE}" > "${TEMP_LOG_FILE}"
            tail -n100 "${LOG_FILE}" >> "${TEMP_LOG_FILE}"
            echo "${TEMP_LOG_FILE}"
        fi
        exit 0
        ;;
    *)
        exit 1
        ;;
esac
